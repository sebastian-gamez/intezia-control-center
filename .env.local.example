# === Acceso del equipo ===
# Clave compartida para entrar a la app (cámbiala por una fuerte)
ACCESS_PASSCODE=intezia2026

# === Fuente de datos ===
# En LOCAL: ruta a la bóveda de contenido (donde están los guiones .md)
# Si defines VAULT_PATH y NO defines GITHUB_TOKEN, la app lee/escribe archivos locales.
VAULT_PATH=../IMAI  # ej: C:/Users/HP/Desktop/12 meses - 12 startups/IMAI

# En PRODUCCIÓN (desplegado): la app lee/escribe el repo de contenido por la API de GitHub.
# Si defines GITHUB_TOKEN, la app usa GitHub en vez de archivos locales.
GITHUB_TOKEN=
GITHUB_OWNER=tu-usuario-github
GITHUB_REPO=intezia-fabrica-contenido
GITHUB_BRANCH=main
# Carpeta dentro del repo donde viven los guiones:
GUIONES_DIR=05_Guiones
