# === Acceso del equipo ===
# Clave compartida para entrar a la app. Es LO ÚNICO que la protege: quien la tenga
# puede leer y editar todos los guiones. Genera una larga y aleatoria, y ponla solo en
# Vercel y en tu .env.local — nunca en este archivo, que sí viaja al repo.
ACCESS_PASSCODE=cambia-esto-por-una-clave-larga-y-aleatoria

# === Fuente de datos ===
# En LOCAL: ruta a la bóveda de contenido (donde están los guiones .md)
# Si defines VAULT_PATH y NO defines GITHUB_TOKEN, la app lee/escribe archivos locales.
# Esta app vive anidada dentro de la bóveda (IMAI/.control-center), así que la bóveda
# es la carpeta padre. Ruta absoluta también funciona.
VAULT_PATH=..

# En PRODUCCIÓN (desplegado): la app lee/escribe el repo de contenido por la API de GitHub.
# Si defines GITHUB_TOKEN, la app usa GitHub en vez de archivos locales.
GITHUB_TOKEN=
GITHUB_OWNER=tu-usuario-github
GITHUB_REPO=IMAI
GITHUB_BRANCH=main
# Carpeta dentro del repo donde viven los guiones (la boveda vive en boveda/):
GUIONES_DIR=boveda/05_Guiones

# === Pipeline unificado (NocoDB) ===
# La app escribe la etapa en la tabla "Contenido" al guardar, para que el equipo lo vea
# al instante. NO toca Rockets ni Videos Editados (producción).
NOCODB_BASE_URL=
NOCODB_TOKEN=
# Los ids de tabla se copian de la URL de NocoDB al abrir cada tabla.
NOCODB_CONTENIDO_TABLE_ID=
NOCODB_LOG_TABLE_ID=
