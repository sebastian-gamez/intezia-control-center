# === Acceso del equipo ===
# Clave compartida para entrar a la app. Es LO ÚNICO que la protege: quien la tenga
# puede leer y editar todos los guiones. Genera una larga y aleatoria, y ponla solo en
# Vercel y en tu .env.local — nunca en este archivo, que sí viaja al repo.
ACCESS_PASSCODE=cambia-esto-por-una-clave-larga-y-aleatoria

# === Los guiones (NocoDB) ===
# Este repo es PÚBLICO: no contiene ni un guion. Viven en NocoDB, y la app los lee y
# escribe ahí. Con estas tres variables la app funciona sola, sin tocar git.
NOCODB_BASE_URL=
NOCODB_TOKEN=
NOCODB_CONTENIDO_TABLE_ID=
NOCODB_LOG_TABLE_ID=

# === Grabación ===
# Carpeta de Drive donde el equipo sube lo que graba. La app enlaza ahí al terminar y
# le dice a cada quien que busque la subcarpeta con su cargo.
# Va aquí y no en el código porque este repo es público: no hay motivo para publicar
# el identificador de la carpeta. Si falta, la app avisa en vez de romperse.
DRIVE_GRABACIONES_URL=

# === Opcional: la bóveda de Obsidian ===
# La bóveda vive en un repo PRIVADO aparte. La app solo la necesita para leer la
# plantilla de guion al crear uno nuevo; sin esto usa una plantilla de respaldo.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# === Solo para desarrollo local contra archivos ===
# Con FUENTE_GUIONES=git la app ignora NocoDB y lee los .md de la bóveda en disco.
# FUENTE_GUIONES=git
# VAULT_PATH=../boveda
# GUIONES_DIR=05_Guiones
